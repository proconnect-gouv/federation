APP_NAME=fia2-low
FQDN=idp2-local.proconnect.127.0.0.1.nip.io

# -- Service Provider
# For tests purposes, fia2 is configured with an oidc callback having
# providerUid as a parameter
# @see https://gitlab.dev-franceconnect.fr/france-connect/fc/-/issues/467
ServiceProviderAdapterEnv_REDIRECT_URIS=["https://federation-local.proconnect.127.0.0.1.nip.io/api/v2/oidc-callback"]
ServiceProviderAdapterEnv_POST_LOGOUT_REDIRECT_URIS=["https://federation-local.proconnect.127.0.0.1.nip.io/api/v2/client/logout-callback"]
ServiceProviderAdapterEnv_CLIENT_ID=myclientidforfia2-low
ServiceProviderAdapterEnv_CLIENT_SECRET=7ae4fef2aab63fb78d777fe657b7536f
ServiceProviderAdapterEnv_SCOPE=openid uid given_name usual_name email siren siret organizational_unit belonging_population phone chorusdt
ServiceProviderAdapterEnv_ID_TOKEN_SIGNED_RESPONSE_ALG=RS256
ServiceProviderAdapterEnv_USERINFO_SIGNED_RESPONSE_ALG=RS256

# Visually distinguishes fia2 from fia1 in local dev
STYLESHEET_URL=https://cdn.jsdelivr.net/gh/raj457036/attriCSS@master/themes/lightfairy-pink.css
