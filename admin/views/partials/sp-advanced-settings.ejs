<details>
  <summary id="open-custom-configuration">Configuration avancée</summary>
  <section class="mb-3 row">
    <label class="col-2 col-form-label"
      >Autorise la Cross Device Authentication (XDA) :
    </label>
    <div class="mb-3 col-4 d-flex align-items-end">
      <div class="form-check form-check-inline">
        <input
          type="radio"
          class="form-check-input is-consent-required <%= locals.messages.errors && messages.errors[0].type && 'is-invalid' %>"
          id="isXdaEnabledTrue"
          name="isXdaEnabled"
          value="true"
          required
        />
        <label class="form-check-label" for="isXdaEnabledTrue">oui</label>
      </div>
      <div class="form-check form-check-inline">
        <input
          type="radio"
          class="form-check-input is-consent-required <%= locals.messages.errors && messages.errors[0].type && 'is-invalid' %>"
          id="isXdaEnabledFalse"
          name="isXdaEnabled"
          value="false"
          checked
          required
        />
        <label class="form-check-label" for="isXdaEnabledFalse">non</label>
      </div>
    </div>
  </section>
</details>
