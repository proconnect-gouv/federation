{
  "name": "fc-system-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress/Cucumber Framework Dependencies",
  "keywords": [
    "Cypress",
    "QA",
    "Cucumber"
  ],
  "scripts": {
    "clean": "rm -rf cypress/fixtures.out && rm -rf cypress/reports && rm -rf cypress/screenshots && rm -rf cypress/videos",
    "format": "prettier --write .",
    "lint": "prettier --check . && yarn run type:check",
    "report": "tsx ./scripts/multiple-cucumber-html-reporter",
    "test:e2e:studio": "cypress open --e2e --config-file cypress-fca-low.config.ts",
    "test:e2e": "cypress run --config-file cypress-fca-low.config.ts",
    "test:e2e:chrome-desktop": "yarn test:e2e --browser chrome --headless",
    "test:e2e:chrome-mobile": "yarn test:e2e --browser chrome --headless --config viewportWidth=320,viewportHeight=568",
    "test:snapshot": "cypress run --headless --config-file cypress-fca-low-visual.config.ts",
    "type:check": "tsc --noEmit"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "dependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@simonsmith/cypress-image-snapshot": "^10.1.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.2.1",
    "axe-core": "^4.12.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cypress": "15.19.0",
    "cypress-axe": "^1.7.0",
    "cypress-maildev": "^2.0.0",
    "cypress-on-fix": "^1.1.0",
    "cypress-plugin-api": "^2.12.0",
    "ejs": "^6.0.1",
    "globals": "^17.8.0",
    "jose": "^6.2.4",
    "lodash": "^4.18.1",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "otpauth": "^9.5.1",
    "otplib": "^13.4.1",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "prettier-plugin-organize-imports": "^4.3.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": ">=22",
    "npm": "DO-NOT-USE-NPM"
  }
}
