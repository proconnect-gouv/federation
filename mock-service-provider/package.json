{
  "name": "mock-service-provider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "start:dev": "node --watch src/main.ts",
    "lint": "prettier --check . && yarn run type:check",
    "format": "prettier --write .",
    "test": "node --experimental-strip-types --test src/app.test.ts",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "body-parser": "^2.3.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "lodash-es": "^4.18.1",
    "openid-client": "^6.8.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.1",
    "@types/ejs": "^3.1.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "prettier-plugin-organize-imports": "^4.3.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  }
}
