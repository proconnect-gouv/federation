<!doctype html>
<html lang="fr" data-fr-scheme="light">
  <head>
    <%- include('includes/head.ejs') %>
    <link rel="stylesheet" href="/css/pages/interaction.css" />
    <link rel="stylesheet" href="/css/pages/dsfr.pc.css" />
    <title>Se connecter via un appareil vérifié - ProConnect</title>
  </head>

  <body>
    <%- include('includes/skiplinks.ejs') %> <%- include('includes/header.ejs')
    %>
    <main role="main" id="content" class="fr-py-2w">
      <div class="fr-container">
        <div class="fr-grid-row fr-grid-row--center">
          <div class="fr-col-12 fr-col-md-8 fr-col-lg-4">
            <h1 class="fr-my-2w fr-h4">
              Se connecter via un appareil vérifié
            </h1>
            <p class="fr-mb-2w">
              Pour vous connecter depuis cet appareil, vous devez disposer d'une
              session active sur ProConnect Fédération depuis votre appareil
              vérifié (par exemple votre poste de travail sur le RIE).
            </p>
            <p class="fr-mb-4w">
              Pour vous en assurer, initiez une connexion sur Docteur ProConnect
              depuis votre appareil vérifié, puis cliquez sur le bouton
              ci-dessous.
            </p>

            <form
              class="fr-mb-2w"
              action="/api/v2/proceed-to-cross-device-authentication"
              method="POST"
            >
              <input
                type="hidden"
                name="csrfToken"
                value="<%= locals.csrfToken %>"
              />

              <button class="fr-btn btn--fullwidth" type="submit">
                Commencer l'authentification
              </button>
            </form>

            <button
              type="button"
              class="fr-btn fr-btn--tertiary-no-outline btn--fullwidth go-back-link"
            >
              Revenir à l'étape précédente
            </button>
          </div>
        </div>
      </div>
    </main>
  </body>
  <script type="text/javascript" src="/js/go-back.js"></script>
</html>
