<!doctype html>
<html lang="fr" data-fr-scheme="light">
  <head>
    <%- include('includes/head.ejs') %>
    <link rel="stylesheet" href="/css/pages/dsfr.pc.css" />
    <title>Maintenance en cours - ProConnect</title>
  </head>
  <body>
    <%- include('includes/skiplinks.ejs') %> <%- include('includes/header.ejs')
    %>
    <main class="fr-container fr-my-8w" role="main" id="content">
      <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle">
        <div class="fr-col-12 fr-col-md-6">
          <h1 class="fr-h2">Site en maintenance</h1>
          <p data-testid="maintenance-description">
            ProConnect est en maintenance
            <% if (locals.maintenanceDatetime) { %><%= maintenanceDatetime %><% } %>.
            <% if (locals.maintenanceDuration) { %>
            Nous prévoyons une durée d’indisponibilité d’au moins
            <%= maintenanceDuration %>.
            <% } %>
          </p>
          <p>Merci de patienter et de rafraîchir la page ultérieurement.</p>
        </div>
        <div class="fr-col-12 fr-col-md-6 fr-grid-row fr-grid-row--center">
          <img src="/img/maintenance.svg" alt="" width="340" />
        </div>
      </div>
    </main>
    <%- include('includes/footer.ejs') %> <%- include('includes/scripts.ejs') %>
  </body>
</html>
