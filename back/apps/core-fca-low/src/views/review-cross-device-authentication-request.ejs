<!doctype html>
<html lang="fr" data-fr-scheme="light">
  <head>
    <%- include('includes/head.ejs') %>
    <link rel="stylesheet" href="/css/pages/interaction.css" />
    <link rel="stylesheet" href="/css/pages/dsfr.pc.css" />
    <title>Vérification de session - ProConnect</title>
  </head>

  <body>
    <%- include('includes/skiplinks.ejs') %> <%- include('includes/header.ejs')
    %>
    <main role="main" id="content" class="fr-py-2w">
      <div class="fr-container">
        <div class="fr-grid-row fr-grid-row--center">
          <div class="fr-col-12 fr-col-md-8 fr-col-lg-4">
            <h1 class="fr-mb-4w fr-h4">
              Vérifiez votre session
            </h1>
        
            <p class="fr-h2 fr-container xda-emojis fr-mb-4w">
              <% emojis.forEach(emoji => { %><span><%= emoji %></span><% }) %>
            </p>
            <p class="fr-mb-2w">
              Les symboles affichés sont-ils identiques sur vos deux appareils ?
            </p>
            <div class="xda-review-actions fr-mb-2w">
              <form
                action="/api/v2/cross-device-authentication-requests/<%= requestId %>/approve"
                method="POST"
              >
                <input
                  type="hidden"
                  name="csrfToken"
                  value="<%= locals.csrfToken %>"
                />
                <button
                  class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-check-line btn--fullwidth"
                  type="submit"
                >
                  Oui
                </button>
              </form>

              <form
                action="/api/v2/cross-device-authentication-requests/<%= requestId %>/reject"
                method="POST"
              >
                <input
                  type="hidden"
                  name="csrfToken"
                  value="<%= locals.csrfToken %>"
                />
                <button
                  class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-close-line btn--fullwidth"
                  type="submit"
                >
                  Non
                </button>
              </form>
            </div>

          </div>
        </div>
      </div>
    </main>
  </body>
</html>
