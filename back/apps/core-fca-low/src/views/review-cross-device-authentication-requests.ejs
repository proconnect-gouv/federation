<!doctype html>
<html lang="fr" data-fr-scheme="light">
  <head>
    <%- include('includes/head.ejs') %>
    <link rel="stylesheet" href="/css/pages/interaction.css" />
    <link rel="stylesheet" href="/css/pages/dsfr.pc.css" />
    <title>Demandes de connexion - ProConnect</title>
  </head>

  <body>
    <%- include('includes/skiplinks.ejs') %> <%- include('includes/header.ejs')
    %>
    <main role="main" id="content" class="fr-py-2w">
      <div class="fr-container">
        <div class="fr-grid-row fr-grid-row--center">
          <div class="fr-col-12 fr-col-md-8 fr-col-lg-4">
            <h1 class="fr-my-2w fr-h4">
              Demandes de connexion en cours
            </h1>

            <% if (awaitingRequests.length > 0) { %>
              <ul class="fr-raw-list">
                <% awaitingRequests.forEach(awaitingRequest => { %>
                  <li class="fr-mb-3w xda-requests-list-item">
                    <p class="fr-mb-1w">
                      <strong><%= awaitingRequest.device %></strong><br />
                      Service : <%= awaitingRequest.spName %>
                    </p>
                    <form
                      action="/api/v2/cross-device-authentication-requests/<%= awaitingRequest.id %>"
                      method="POST"
                    >
                      <input
                        type="hidden"
                        name="csrfToken"
                        value="<%= locals.csrfToken %>"
                      />
                      <button type="submit" class="fr-btn fr-btn--secondary">
                        Examiner
                      </button>
                    </form>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <p>Aucune demande de connexion en cours.</p>
            <% } %>

          </div>
        </div>
      </div>
    </main>
  </body>
</html>
