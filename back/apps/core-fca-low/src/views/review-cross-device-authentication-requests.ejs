<!doctype html>
<html lang="fr" data-fr-scheme="light">
  <head>
    <%- include('includes/head.ejs') %>
    <link rel="stylesheet" href="/css/pages/interaction.css" />
    <link rel="stylesheet" href="/css/pages/dsfr.pc.css" />
    <title>Demandes de connexion - ProConnect</title>
  </head>

  <body>
    <%- include('includes/skiplinks.ejs') %> <%- include('includes/header.ejs')
    %>
    <main role="main" id="content" class="fr-py-2w">
      <div class="fr-container">
        <div class="fr-grid-row fr-grid-row--center">
          <div
            class="fr-col-12 fr-col-md-8 fr-col-lg-4 xda-review-requests"
            data-awaiting-requests-url="/api/v2/cross-device-authentication-awaiting-requests"
            aria-live="polite"
          >
            <h1 class="fr-my-2w fr-h4">
              Demandes de connexion en cours
            </h1>

            <% if (awaitingRequests.length > 0) { %>
              <ul class="fr-raw-list">
                <% awaitingRequests.forEach(awaitingRequest => { %>
                  <li
                    class="fr-mb-3w xda-requests-list-item"
                    data-request-id="<%= awaitingRequest.id %>"
                  >
                    <p class="fr-mb-1w">
                      Navigateur : <strong><%= awaitingRequest.device %></strong><br />
                      Date : <strong>le <time
                        datetime="<%= awaitingRequest.createdAt.toISOString() %>"
                        data-local-date
                      ><%= awaitingRequest.createdAt.toISOString() %></time></strong><br />
                      Service : <strong><%= awaitingRequest.spName %></strong>
                    </p>
                    <form
                      action="/api/v2/cross-device-authentication-requests/<%= awaitingRequest.id %>"
                      method="POST"
                    >
                      <input
                        type="hidden"
                        name="csrfToken"
                        value="<%= locals.csrfToken %>"
                      />
                      <button type="submit" class="fr-btn fr-btn--secondary">
                        Examiner
                      </button>
                    </form>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <p>Aucune demande de connexion en cours.</p>
            <% } %>

          </div>
        </div>
      </div>
    </main>
  </body>
  <script type="text/javascript" src="/js/local-date.js"></script>
  <script type="module" src="/js/xda-polling-requests.js"></script>
</html>
