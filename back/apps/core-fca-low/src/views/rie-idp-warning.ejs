<!doctype html>
<html lang="fr" data-fr-scheme="light">
  <head>
    <%- include('includes/head.ejs') %>
    <link rel="stylesheet" href="/css/pages/interaction.css" />
    <link rel="stylesheet" href="/css/pages/dsfr.pc.css" />
    <title>Alerte connexion RIE - ProConnect</title>
  </head>

  <body>
    <%- include('includes/skiplinks.ejs') %> <%- include('includes/header.ejs')
    %>
    <main role="main" id="content" class="fr-py-2w">
      <div class="fr-container">
        <div class="fr-grid-row">
          <div class="fr-col-12 fr-col-md-6">
            <h1 class="fr-my-2w fr-h3">
              Authentification hors RIE
            </h1>
            <p>
              Vous semblez être sur <strong>le réseau Internet.</strong><br />
              Votre portail d'authentification habituel pourrait ne pas être disponible.
            </p>
            
            <% if (locals.isXdaEnabled) { %>
            <p>
              Pour vous connecter, vous pouvez :
            </p>
            <ul>
              <li><strong>activer votre VPN</strong> sur cet appareil et continuer.</li>
              <li><strong>vérifier ce nouvel appareil depuis une session ProConnect sur votre ordinateur RIE</strong> (celui de votre bureau)</li>
            </ul>
            
            <% } else { %>
            <p>
              Pour vous connecter, il vous faut <strong>activer votre VPN</strong> sur cet appareil et continuer.
            </p>
            <% }  %>

            <div class="fr-grid-row fr-grid-row--middle">
              <form
                class="fr-col-6"
                action="/api/v2/proceed-to-idp"
                method="POST"
              >
                <input
                  type="hidden"
                  name="csrfToken"
                  value="<%= locals.csrfToken %>"
                />

                <button
                  class="fr-btn btn--fullwidth <%= !locals.isXdaEnabled ? 'fr-btn--tertiary-no-outline' : '' %>"
                  type="submit"
                >
                  Continuer
                </button>
              </form>

              <% if (locals.isXdaEnabled) { %>
                <form
                  class="fr-col-6"
                  action="/api/v2/cross-device-authentication-request"
                  method="POST"
                >
                  <input
                    type="hidden"
                    name="csrfToken"
                    value="<%= locals.csrfToken %>"
                  />

                  <button class="fr-btn btn--fullwidth fr-btn--tertiary-no-outline" type="submit">
                    Vérifier depuis l'ordinateur RIE
                  </button>
                </form>
              <% } %>
            </div>
          </div>
          <div class="fr-col-md-6 fr-hidden fr-unhidden-md fr-grid-row fr-grid-row--center">
            <img src="/img/idea.svg" alt="" aria-hidden="true" />
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
