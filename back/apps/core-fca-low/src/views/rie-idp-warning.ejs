<!doctype html>
<html lang="fr" data-fr-scheme="light">
  <head>
    <%- include('includes/head.ejs') %>
    <link rel="stylesheet" href="/css/pages/interaction.css" />
    <link rel="stylesheet" href="/css/pages/dsfr.pc.css" />
    <title>Alerte connexion RIE - ProConnect</title>
  </head>

  <body>
    <%- include('includes/skiplinks.ejs') %> <%- include('includes/header.ejs')
    %>
    <main role="main" id="content" class="fr-py-2w">
      <div class="fr-container">
        <div class="fr-grid-row fr-grid-row--center">
          <div class="fr-col-12 fr-col-md-8 fr-col-lg-4">
            <h1 class="fr-my-2w fr-h4">
              Le Fournisseur d'Identité "<%= idpName %>" n'est accessible que
              depuis le RIE.
            </h1>
            <p class="fr-my-6b">
              La connexion n'est peut-être pas disponible sur Internet
            </p>
            <form
              class="fr-mb-2w"
              action="/api/v2/proceed-to-cross-device-authentication"
              method="POST"
            >
              <input
                type="hidden"
                name="csrfToken"
                value="<%= locals.csrfToken %>"
              />

              <button class="fr-btn btn--fullwidth" type="submit">
                Continuer en Cross-Device
              </button>
            </form>

            <form
              class="fr-mb-2w"
              action="/api/v2/proceed-to-idp"
              method="POST"
            >
              <input
                type="hidden"
                name="csrfToken"
                value="<%= locals.csrfToken %>"
              />

              <button
                class="fr-btn btn--fullwidth fr-btn--tertiary-no-outline"
                type="submit"
              >
                Continuer quand même
              </button>
            </form>
            <button
              type="button"
              class="fr-btn fr-btn--tertiary-no-outline btn--fullwidth go-back-link"
            >
              Revenir à l'étape précédente
            </button>
          </div>
        </div>
      </div>
    </main>
  </body>
  <script type="text/javascript" src="/js/go-back.js"></script>
</html>
